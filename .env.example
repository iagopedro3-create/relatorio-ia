# Copie para .env (local) e configure as mesmas variáveis no projeto da Vercel.
# .env não vai para o git.

# ---------------------------------------------------------------------------
# FRONT (prefixo VITE_ = vai para o navegador; nunca coloque segredo aqui)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://<ref>.supabase.co
# Chave publicável (sb_publishable_... ou anon). Quem protege os dados é a RLS.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Nome neutro do produto (tela de login, títulos). A escola personaliza o resto.
VITE_PRODUCT_NAME=Althion Education

# ---------------------------------------------------------------------------
# SERVIDOR (funções em /api — só na Vercel / `vercel dev`; sem prefixo VITE_)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://<ref>.supabase.co
# service_role: ignora RLS. NUNCA exponha, NUNCA use no front.
SUPABASE_SERVICE_ROLE_KEY=

# Provedor de IA da PLATAFORMA (a chave é sua; a escola não configura nada)
AI_PROVIDER=gemini            # gemini | openai
AI_API_KEY=
AI_MODEL=gemini-2.5-flash     # padrão para todas as funcionalidades
# Opcional, por funcionalidade: AI_MODEL_REPORT, AI_MODEL_PEI, AI_MODEL_PEDAGOGICAL, AI_MODEL_PLANNING

# URL pública do app (links de e-mail de redefinição de senha)
APP_URL=https://althioneduapp.vercel.app

# Cobrança (Stripe). Deixe em branco para operar só pelo backoffice.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Mapa plano -> price id do Stripe, JSON: {"essencial":"price_...","completo":"price_..."}
STRIPE_PRICES=

# E-mail transacional (opcional). Sem chave, nenhum aviso é enviado.
RESEND_API_KEY=
NOTIFY_FROM=Althion Education <notificacoes@seudominio.com.br>
